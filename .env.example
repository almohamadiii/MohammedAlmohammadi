# Copy to .env and adjust. compose reads .env automatically; .env is
# gitignored, .env.example is committed. Authored in W2D5.

# The image compose runs: your day-3 push, then cpu-v2 after day 5's changes.
IMAGE=your-user/aidc-serving:cpu-v1

# Which model the service loads and reports.
MODEL_ID=Qwen/Qwen2.5-0.5B-Instruct

# Host port the service publishes on (the container side stays 8000).
HOST_PORT=8000

# Day 5, step 4: bearer key for /v1/* (empty = open, with a loud startup warning).
API_KEY=

# Day 5, step 4: hard ceiling on max_tokens per request.
MAX_TOKENS=256
